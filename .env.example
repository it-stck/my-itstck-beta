# ==============================================================================
# ItStack SaaS Environment Configuration (Ubuntu / Debian 13 VPS)
# ==============================================================================

# 1. Base URL (Set to your domain or host IP: http://<YOUR_VPS_IP>:3000)
APP_URL=http://localhost:3000

# 2. Host Port & Environment
PORT=3000
NODE_ENV=production

# 3. PostgreSQL Database Credentials (Configured for the 'db' container)
POSTGRES_USER=itstack
POSTGRES_PASSWORD=itstack_secure_password
POSTGRES_DB=itstack_db

# 4. GitHub OAuth 2.0 Credentials (ONLY required external credentials)
# Obtain these from: https://github.com/settings/developers -> New OAuth App
# - Homepage URL: http://<YOUR_VPS_IP>:3000 (or https://my.itstck.com)
# - Authorization callback URL: http://<YOUR_VPS_IP>:3000 (or https://my.itstck.com)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 5. Session Cryptographic Secret (32+ random characters)
SESSION_SECRET=itstack_prod_secret_replace_with_random_32_characters
