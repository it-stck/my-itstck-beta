# ==============================================================================
# ItStack (my.itstck.com) Production Environment Configuration
# ==============================================================================

# 1. Base Application & Domain
# Used for canonical routes (/@username, /u/username) and OAuth callbacks
APP_URL="https://my.itstck.com"
PORT=3000
NODE_ENV="production"

# 2. PostgreSQL Relational Database (Docker container: 'db')
# If DATABASE_URL is unset, ItStack automatically falls back to persistent JSON storage in /app/data
DATABASE_URL="postgres://itstack:itstack_secure_password@db:5432/itstack_db"

# 3. GitHub OAuth 2.0 Credentials (Strictly 1 GitHub Account = 1 Verified Profile)
# Obtain these from: https://github.com/settings/developers -> New OAuth App
# Homepage URL: https://my.itstck.com
# Authorization callback URL: https://my.itstck.com
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# 4. Session & Cryptographic Token Secret (32+ bytes random string)
SESSION_SECRET="itstack_prod_secret_replace_with_openssl_rand_hex_32"
