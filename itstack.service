[Unit]
Description=ItStack Production SaaS Engine (my.itstck.com)
After=network.target

[Service]
Type=simple
User=itstack
Group=itstack
WorkingDirectory=/opt/itstack
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=APP_URL=https://my.itstck.com

# Hardening measures
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
