// Prisma schema for IT Stack SaaS
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth.js required models
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Application models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Custom profile fields
  username  String?  @unique
  role      UserRole @default(USER)
  plan      UserPlan @default(FREE)
  planExpires DateTime?

  // Onboarding
  onboardingCompleted Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts Account[]
  sessions Session[]
  profile  Profile?
  follows  Follow[]  @relation("Follower")
  followers Follow[] @relation("Following")

  @@index([email])
  @@index([username])
}

enum UserRole {
  USER
  PRO
  ADMIN
}

enum UserPlan {
  FREE
  PRO
  TEAM
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic info (cached here for performance; also editable from sections)
  headline     String? // Professional title, e.g. "Senior Full-Stack Developer"
  location     String?
  website      String?
  bio          String? @db.Text
  contactEmail String? // Public contact email (distinct from auth email)

  // Social links (just the handle/username, not full URL)
  github   String?
  linkedin String?
  twitter  String?
  youtube  String?
  devto    String?

  // Custom avatar (override OAuth avatar)
  avatarUrl String?

  // Theme & appearance
  theme       String @default("default")  // default|dark|ocean|terminal|minimal|glass
  font        String @default("inter")    // inter|mono|poppins|serif|fira
  accentColor String @default("#6366f1")  // hex color
  layout      String @default("sidebar")  // sidebar|centered|columns
  showAvatar  Boolean @default(true)
  showStats   Boolean @default(true)

  // SEO
  seoTitle       String?
  seoDescription String?

  // Visibility
  isPublic     Boolean @default(false) // false until onboarding done
  isIndexed    Boolean @default(true)  // allow search engine indexing

  // Analytics
  viewCount Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sections Section[]

  @@index([userId])
}

model Section {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Content
  type      SectionType
  title     String
  content   String      @db.Text // Markdown content
  order     Int         @default(0)
  isVisible Boolean     @default(true)

  // Type-specific metadata (JSON)
  metadata Json? // e.g. { icon, color, columns, layout }

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([profileId, order])
}

enum SectionType {
  HEADER       // Name, title, location, contact
  ABOUT        // About me / summary
  EXPERIENCE   // Work experience
  EDUCATION    // Education history
  SKILLS       // Tech skills / stack badges
  PROJECTS     // Portfolio projects
  CERTIFICATIONS
  LANGUAGES    // Spoken languages
  AWARDS
  PUBLICATIONS
  VOLUNTEER
  OPEN_SOURCE  // Open source contributions
  CUSTOM       // Free-form custom section
}

model Follow {
  id          String @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
